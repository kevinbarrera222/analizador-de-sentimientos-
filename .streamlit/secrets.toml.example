# Copia este archivo como .streamlit/secrets.toml (en tu computador)
# o pega su contenido en "Settings → Secrets" de Streamlit Cloud.

OPENAI_API_KEY = "sk-..."

# Reseñas que se pueden analizar de una sola vez
MAX_RESENAS_POR_ANALISIS = 20

# Reseñas que cada usuario puede analizar por día
MAX_RESENAS_POR_USUARIO = 60

# Tope total de reseñas por día sumando a todos los usuarios
MAX_RESENAS_GLOBALES_DIA = 1500

# (Opcional) Modelo de OpenAI
# OPENAI_MODEL = "gpt-6-luna"
